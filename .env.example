# Frontend environment variables
# Copy to .env.local and fill in real values

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===== Analytics (optional) =====
# GA4 Measurement ID. Analytics only loads after the visitor grants consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML tag token (only the content value, not the full meta tag).
GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# ===== AI Services =====
# Local development: create a Vercel AI Gateway key.
# Or run `vercel env pull apps/web/.env.local` to receive VERCEL_OIDC_TOKEN.
# Vercel deployments authenticate automatically through OIDC.
AI_GATEWAY_API_KEY=vck_your_ai_gateway_api_key
AI_GATEWAY_MODEL=openai/gpt-6-astra

# Existing Groq credentials take priority over AI Gateway when present.
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@4b.vn

# ===== Optional =====
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Logo (URL or local path)
NEXT_PUBLIC_LOGO_URL=/logo.png
