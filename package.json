{
  "name": "4b-platform",
  "version": "0.1.0",
  "private": true,
  "description": "4B — Nền tảng quản lý phòng trọ, chia chi phí tự động. For Better Balance.",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npx --yes vercel@latest env run -- npm --workspace @4b/web run dev",
    "dev:offline": "npm --workspace @4b/web run dev",
    "build": "cd apps/web && npm run build",
    "start": "cd apps/web && npm run start",
    "lint": "cd apps/web && npm run lint",
    "typecheck": "cd apps/web && npm run type-check",
    "test": "cd apps/web && npm run test",
    "admin:grant": "node --env-file=apps/web/.env.local scripts/grant-admin.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
